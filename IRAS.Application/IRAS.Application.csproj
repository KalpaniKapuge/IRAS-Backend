<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IRAS.Domain\IRAS.Domain.csproj" />
    <ProjectReference Include="..\IRAS.Infrastructure\IRAS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.39.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.1" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IFormFile in IResumeService — this is a plain class library, so the
         ASP.NET Core types aren't available unless referenced explicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not deployed as loose files) so CvPdfRenderer can register the exact same
         Roboto weights the web app loads from Google Fonts (see frontend's index.html and
         tailwind.config.ts) — this is what makes the downloaded PDF's typography match the
         live CV preview instead of falling back to QuestPDF's default font. -->
    <EmbeddedResource Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
